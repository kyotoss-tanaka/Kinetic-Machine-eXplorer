<Project Sdk="Microsoft.NET.Sdk">

  <!--
    KMX の起動用ランチャー（KMX.exe の横に置く KMXLauncher.exe）。
    Unity の実行ファイルは DLL を読み終わるまで画面を出せないので、押してすぐに起動中の画面を出す。
    .NET Framework 4.8（Windows に最初から入っている）で作るので、使う PC に何も入れずに動く。
    ビルド：dotnet build -c Release → ../KMXLauncher.exe（Tools の直下）へコピーする。BuildAndRun が実行環境へ写す。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>KMXLauncher</AssemblyName>
    <RootNamespace>KMXLauncher</RootNamespace>
    <ApplicationIcon>kmx.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>KMX Launcher</Product>
    <Company>Kyoto Seisakusho Co., Ltd.</Company>
    <Version>1.0.0</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <EmbeddedResource Include="splash.png" LogicalName="splash.png" />
  </ItemGroup>

  <!-- 出来た exe を Tools/KMXLauncher.exe へ（リポジトリに入れて、BuildAndRun が実行環境へ写す） -->
  <Target Name="CopyToTools" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildProjectDirectory)\.." />
  </Target>

</Project>
