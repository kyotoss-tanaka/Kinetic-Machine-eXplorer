root = true

# 文字コードの統一（Shift-JIS混在による文字化けの再発防止）
[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = false
trim_trailing_whitespace = false

# C# は UTF-8 (BOM付き)。Unity/Visual Studio の既定に合わせ、エンコード検出を確実にする
[*.cs]
charset = utf-8-bom
indent_style = space
indent_size = 4

[*.{json,asmdef,asmref}]
charset = utf-8
indent_style = space
indent_size = 2
